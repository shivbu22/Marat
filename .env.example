# ========== LLM Configuration ==========
LLM_PROVIDER=ollama          # ollama | openai | openrouter | anthropic
LLM_MODEL=llama3.2           # or gpt-4o-mini, claude-3-5-sonnet, etc.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama           # required for openai/openrouter/anthropic

TEMPERATURE=0.2
MAX_TOKENS=4096
MAX_TOOL_TURNS=12

# ========== Search Tools ==========
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=6
SEARCH_DEPTH=basic           # basic | advanced (Tavily only)

# ========== RAG ==========
RAG_ENABLED=true
RAG_PERSIST_DIR=./data/chroma
RAG_COLLECTION=research_vault
EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ========== Agent Behavior ==========
MAX_SUB_QUESTIONS=5
MAX_REVIEW_CYCLES=2
PARALLEL_RESEARCHERS=true
REQUIRE_SOURCES=true

# ========== API ==========
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ========== Observability ==========
LOG_LEVEL=INFO
SAVE_REPORTS_DIR=./reports
